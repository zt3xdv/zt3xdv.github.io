{
  "name": "zt3xdv-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://zt3xdv.github.io",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./index.html --outdir=dist --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
